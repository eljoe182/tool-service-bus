AZURE_SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_DATA_DIR=data
LOG_LEVEL=INFO

## Service Bus Emulator

ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=

# Service Bus
SERVICEBUS_AMQP_HOST_PORT=5672
SERVICEBUS_HTTP_HOST_PORT=5300
EMULATOR_HTTP_PORT=5300
SQL_WAIT_INTERVAL=15

# Event Hubs
EVENTHUBS_AMQP_HOST_PORT=5673
EVENTHUBS_KAFKA_HOST_PORT=9092
EVENTHUBS_HTTP_HOST_PORT=5301
DEFAULT_SB_CONNECTION_STRING="Endpoint=sb://localhost:5672;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
DEFAULT_EH_CONNECTION_STRING="Endpoint=sb://localhost:5673;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"

# Azurite
AZURITE_BLOB_HOST_PORT=10000
AZURITE_QUEUE_HOST_PORT=10001
AZURITE_TABLE_HOST_PORT=10002
